  },
  {
    "op": "simulate",
    "days": 1.0
  },
  {
    "op": "load",
    "slot": "upgrade"
  },
  {
    "op": "assert",
    "check": "save_round_trip"
  },
  {
    "op": "assert",
    "check": "building_is",
    "type": "grain_warehouse"
  },
  {
    "op": "note",
    "text": "and the same for the smithy, which needs iron for it"
