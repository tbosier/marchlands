  {
    "op": "upgrade_building",
    "type": "granary"
  },
  {
    "op": "note",
    "text": "it is a building site now, not a new building elsewhere"
  },
  {
    "op": "simulate",
    "days": 6.0
  },
  {
    "op": "assert",
    "check": "building_is",
    "type": "grain_warehouse"
  },
  {
    "op": "assert",
    "check": "no_stale_reservations"
  },
  {
    "op": "note",
    "text": "and it survives a save"
  },
  {
    "op": "save",
